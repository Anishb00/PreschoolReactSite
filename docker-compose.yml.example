services:
  web:
    build: .
    image: preschoolreactsite
    restart: unless-stopped
    ports:
      - "3000:3000"

    environment:
      DB_HOST: db_Host
      DB_PORT: "3306"
      DB_NAME: your_db
      DB_USER: your_user
      DB_PASSWORD: your_password
      NODE_END: production

    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:3000/api/health"]
      interval: 10s
      timeout: 3s
      retries: 10
